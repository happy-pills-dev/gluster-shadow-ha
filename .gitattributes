# Force LF for all text files — these configs run on Linux servers
* text=auto eol=lf

# Explicitly mark shell scripts and configs as text/LF
*.sh    text eol=lf
*.conf  text eol=lf
*.md    text eol=lf
*.html  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.timer text eol=lf
*.mount text eol=lf
.gitignore text eol=lf
